---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CommitteeList from '../components/CommitteeList.astro';
import SpeakerGrid from '../components/SpeakerGrid.astro';
import SponsorGrid from '../components/SponsorGrid.astro';
import EmptyState from '../components/EmptyState.astro';
import PageSections from '../components/PageSections.astro';
import committees from '../data/committees.json';
import speakers from '../data/speakers.json';
import sponsors from '../data/sponsors.json';
import heroImages from '../data/heroImages.json';

interface PageData {
  slug: string;
  title: string;
  summary: string;
  kind: 'basic' | 'committee' | 'speakers' | 'sponsors';
  committeeSlug?: string;
  sections?: Array<Record<string, unknown>>;
}

export function getStaticPaths() {
  const pageModules = import.meta.glob<PageData>('../data/pages/**/*.json', {
    eager: true,
    import: 'default',
  });
  const pages = Object.values(pageModules);

  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: PageData };
const committee = page.kind === 'committee'
  ? committees.find((item) => item.slug === page.committeeSlug)
  : undefined;
const isOrganizingCommitteePage = page.kind === 'committee' && page.committeeSlug === 'organizing-committee';
const isSymposiaOverviewPage = page.slug === 'symposia';
const isCallForPapersPage = page.slug === 'submissions/call-for-papers';
const isSubmissionInstructionsPage = page.slug === 'submissions/instructions';
const showPageHeading = !isOrganizingCommitteePage;
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
const withBase = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href === '/') return base;
  return `${cleanBase}${href}`;
};
const getSymposiaHeroImage = (slug: string) => {
  if (!slug.startsWith('symposia/') || !heroImages.length) return undefined;
  const seed = Array.from(slug).reduce((sum, char) => sum + char.charCodeAt(0), 0);
  return heroImages[seed % heroImages.length];
};
const symposiaHeroImage = getSymposiaHeroImage(page.slug);
---

<BaseLayout title={page.title} description={page.summary}>
  <section class:list={[
    'section',
    'inner-page',
    isOrganizingCommitteePage && 'committee-page-section',
    isSymposiaOverviewPage && 'symposia-overview-page',
    isCallForPapersPage && 'call-for-papers-page',
    isSubmissionInstructionsPage && 'submission-instructions-page',
  ]}>
    <div class:list={['container', 'page-content', isOrganizingCommitteePage && 'committee-page-content']}>
      {showPageHeading && (
        <header class="content-page-heading">
          <p class="sub-header">IEEE SSCI 2027</p>
          <h1>{page.title}</h1>
          {page.summary && <p>{page.summary}</p>}
        </header>
      )}
      {symposiaHeroImage && (
        <img
          class="content-hero-image"
          src={withBase(symposiaHeroImage.src)}
          alt={symposiaHeroImage.alt}
          loading="lazy"
        />
      )}
      {isOrganizingCommitteePage && page.kind === 'committee' && committee ? (
        <>
          <CommitteeList name={committee.name} members={committee.members} />
          {page.sections?.length ? (
            <div class="committee-notes">
              <PageSections sections={page.sections} />
            </div>
          ) : null}
        </>
      ) : (
        <>
          <PageSections sections={page.sections} />
          {page.kind === 'committee' && committee && <CommitteeList name={committee.name} members={committee.members} />}
          {page.kind === 'speakers' && (
            <>
              <SpeakerGrid title="Plenary Speakers" speakers={speakers.plenary} />
              <SpeakerGrid title="Keynote Speakers" speakers={speakers.keynote} />
            </>
          )}
          {page.kind === 'sponsors' && (
            <>
              <SectionHeader title="Sponsors" text={page.summary} />
              <SponsorGrid sponsors={sponsors} />
            </>
          )}
          {!page.sections?.length && page.kind === 'basic' && <EmptyState title="Information will be posted here." />}
        </>
      )}
    </div>
  </section>
</BaseLayout>
