---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NewsTicker from '../components/NewsTicker.astro';
import SpeakerGrid from '../components/SpeakerGrid.astro';
import site from '../data/site.json';
import news from '../data/news.json';
import speakers from '../data/speakers.json';

const hasNews = news.length > 0;
const hasSpeakers = speakers.plenary.length > 0 || speakers.keynote.length > 0;
const base = import.meta.env.BASE_URL;
const withAssetBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<BaseLayout>
  <Hero />

  <div class="home-main" id="main">
    <section class="about home-about" id="about">
      <div class="container">
        {hasNews && <NewsTicker items={news} />}
        <div class="row justify-content-between">
          <div class="col-lg-12 pt-5 pt-lg-0 welcome-content">
            <h3>{site.welcomeTitle}</h3>
            <p>
              <img class="welcome-inline-image img-fluid" src={withAssetBase('/assets/images/hero/gold-coast-2027-02.jpg')} alt="Gold Coast waterways and skyline" />
              {site.welcomeBody[0]}
            </p>
            {site.welcomeBody.slice(1).map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>

    {hasSpeakers && (
      <section class="about home-speakers">
        <div class="container">
          {speakers.plenary.length > 0 && <SpeakerGrid title="Plenary Speakers" speakers={speakers.plenary} />}
          {speakers.keynote.length > 0 && <SpeakerGrid title="Keynote Speakers" speakers={speakers.keynote} />}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
