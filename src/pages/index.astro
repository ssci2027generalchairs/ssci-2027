---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NewsTicker from '../components/NewsTicker.astro';
import ImportantDates from '../components/ImportantDates.astro';
import SpeakerGrid from '../components/SpeakerGrid.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import site from '../data/site.json';
import news from '../data/news.json';
import importantDates from '../data/importantDates.json';
import speakers from '../data/speakers.json';
import sponsors from '../data/sponsors.json';

const hasNews = news.length > 0;
const hasPlenary = speakers.plenary.length > 0;
const hasKeynote = speakers.keynote.length > 0;
const base = import.meta.env.BASE_URL;
const withAssetBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<BaseLayout>
  <Hero />

  <div class="home-main">
    <section class="home-about" id="about">
      <div class="container">
        {hasNews && <NewsTicker items={news} />}
        <div class="welcome-content">
          <h2>{site.welcomeTitle}</h2>
          <img class="welcome-inline-image" src={withAssetBase('/assets/images/hero/gold-coast-2027-02.jpg')} alt="Gold Coast waterways and skyline" />
          {site.welcomeBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="home-dates">
      <div class="container">
        <div class="home-section-title">
          <p>Important Dates</p>
        </div>
        <ImportantDates dates={importantDates} />
      </div>
    </section>

    <section class="home-sponsors">
      <div class="container">
        <div class="home-section-title">
          <p>Sponsors</p>
        </div>
        <SponsorStrip sponsors={sponsors} />
      </div>
    </section>

    {(hasPlenary || hasKeynote) && (
      <section class="home-speakers">
        <div class="container">
          {hasPlenary && <SpeakerGrid title="Plenary Speakers" speakers={speakers.plenary} />}
          {hasKeynote && <SpeakerGrid title="Keynote Speakers" speakers={speakers.keynote} />}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
