---
import EmptyState from './EmptyState.astro';

interface NewsItem {
  title: string;
  href?: string;
  date?: string;
  summary?: string;
}

interface Props {
  items: NewsItem[];
}
---

{Astro.props.items.length > 0 ? (
  <div class="news-list">
    {Astro.props.items.map((item) => (
      <article class="news-item">
        {item.date && <time datetime={item.date}>{item.date}</time>}
        <h3>
          {item.href ? <a href={item.href}>{item.title}</a> : item.title}
        </h3>
        {item.summary && <p>{item.summary}</p>}
      </article>
    ))}
  </div>
) : (
  <EmptyState title="No updates yet" text="News and announcements will appear here as soon as they are confirmed." />
)}
