---
interface TableData {
  headers: string[];
  rows: string[][];
}

interface LinkItem {
  label: string;
  href: string;
}

interface CardItem {
  title: string;
  href: string;
  image?: string;
  text?: string;
}

interface SectionData {
  heading?: string;
  paragraphs?: string[];
  bullets?: Array<string | LinkItem>;
  cards?: CardItem[];
  table?: TableData;
}

interface Props {
  sections?: SectionData[];
}

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
const withBase = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href === '/') return base;
  return `${cleanBase}${href}`;
};
---

{Astro.props.sections?.length ? (
  <div class="page-sections">
    {Astro.props.sections.map((section) => (
      <section class="content-section">
        {section.heading && <h2>{section.heading}</h2>}
        {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}
        {section.bullets?.length ? (
          <ul>
            {section.bullets.map((item) => (
              <li>
                {typeof item === 'string' ? <Fragment set:html={item} /> : <a href={withBase(item.href)}>{item.label}</a>}
              </li>
            ))}
          </ul>
        ) : null}
        {section.cards?.length ? (
          <div class="link-card-grid">
            {section.cards.map((card) => (
              <a class="link-card" href={withBase(card.href)}>
                {card.image && <img src={withBase(card.image)} alt="" loading="lazy" />}
                <span>{card.title}</span>
                {card.text && <small>{card.text}</small>}
              </a>
            ))}
          </div>
        ) : null}
        {section.table && (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  {section.table.headers.map((header) => <th>{header}</th>)}
                </tr>
              </thead>
              <tbody>
                {section.table.rows.map((row) => (
                  <tr>
                    {row.map((cell) => <td set:html={cell} />)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    ))}
  </div>
) : null}
