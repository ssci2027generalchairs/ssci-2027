---
import site from '../data/site.json';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
const withBase = (href: string) => href === '/' ? base : `${cleanBase}${href}`;
const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Call for Papers', href: '/submissions/call-for-papers/' },
  { label: 'Symposia Overview', href: '/symposia/' },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <section>
      <h2>{site.shortName}</h2>
      <p>{site.name}</p>
      <p>{site.locationLabel} · {site.datesLabel}</p>
    </section>
    <section>
      <h2>Quick Links</h2>
      <nav aria-label="Footer navigation">
        {quickLinks.map((link) => (
          <a href={withBase(link.href)}>{link.label}</a>
        ))}
      </nav>
    </section>
    <section>
      <h2>Contact</h2>
      <a href={withBase('/about/contact/')}>Contact Us</a>
    </section>
  </div>
  <div class="footer-bottom">
    <span>© {site.year} IEEE SSCI.</span>
  </div>
</footer>
