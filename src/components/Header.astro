---
import site from '../data/site.json';
import navigation from '../data/navigation.json';

const currentPath = Astro.url.pathname;
const visibleNavigation = navigation.filter((item: typeof navigation[number] & { hidden?: boolean }) => !item.hidden);
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
const withBase = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href === '/') return base;
  return `${cleanBase}${href}`;
};
const isActive = (href: string) => {
  const target = withBase(href);
  if (href === '/') return currentPath === base;
  return currentPath.startsWith(target);
};
---

<header class="site-header">
  <div class="ieee-bar">
    <nav class="ieee-links" aria-label="IEEE links">
      {site.ieeeLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
      ))}
    </nav>
    <a class="join-link" href="https://www.ieee.org/join" target="_blank" rel="noreferrer">Join IEEE</a>
  </div>

  <div class="main-nav-wrap">
    <a class="brand" href={withBase('/')} aria-label={`${site.shortName} home`}>
      <img class="brand-logo" src={withBase('/assets/images/ssci-2027-logo.svg')} alt={`${site.shortName} logo`} width="280" height="72" />
    </a>

    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Toggle navigation" />
    <label class="nav-toggle-button" for="nav-toggle" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="primary-nav" aria-label="Primary navigation">
      <ul>
        {visibleNavigation.map((item) => {
          const children = item.items || [];
          const parentHref = item.href || children[0]?.href || '/';
          const active = item.href
            ? isActive(item.href)
            : children.some((child) => isActive(child.href));

          return (
            <li class:list={['nav-item', children.length && 'has-menu']}>
              <a class:list={[active && 'active']} href={withBase(parentHref)} aria-haspopup={children.length ? 'true' : undefined}>
                {item.label}
              </a>
              {children.length ? (
                <ul class="dropdown">
                  {children.map((child) => (
                    <li><a class:list={[isActive(child.href) && 'active']} href={withBase(child.href)}>{child.label}</a></li>
                  ))}
                </ul>
              ) : null}
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
