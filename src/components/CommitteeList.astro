---
import EmptyState from './EmptyState.astro';

interface Member {
  name: string;
  role?: string;
  affiliation?: string;
  email?: string;
  status?: string;
  note?: string;
}

interface Props {
  name: string;
  members: Member[];
}
---

<section class="committee-list">
  <h2>{Astro.props.name}</h2>
  {Astro.props.members.length > 0 ? (
    <div class="member-grid">
      {Astro.props.members.map((member) => (
        <article class="member-card">
          {member.role && <p>{member.role}</p>}
          <h3>{member.name}</h3>
          {member.affiliation && <span>{member.affiliation}</span>}
          {member.email && <a href={`mailto:${member.email}`}>{member.email}</a>}
          {member.status && <em>{member.status}</em>}
          {member.note && <small>{member.note}</small>}
        </article>
      ))}
    </div>
  ) : (
    <EmptyState title="Committee members not announced yet" text="Names, roles, and affiliations can be added through the committee data file." />
  )}
</section>
